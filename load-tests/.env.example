# ==============================================================================
# EventEase k6 Load Testing Configuration Environment Variables
# ==============================================================================

# Target Supabase Project (prefer staging / dedicated load test project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Test Credentials (Dedicated test accounts only - never use real accounts)
TEST_CUSTOMER_EMAIL=loadtest_customer@eventease.test
TEST_CUSTOMER_PASSWORD=TestCustomerSecurePass123!
TEST_CUSTOMER_ID=00000000-0000-0000-0000-000000000001

TEST_VENDOR_EMAIL=loadtest_vendor@eventease.test
TEST_VENDOR_PASSWORD=TestVendorSecurePass123!
TEST_VENDOR_ID=00000000-0000-0000-0000-000000000002

TEST_ORGANIZER_EMAIL=loadtest_organizer@eventease.test
TEST_ORGANIZER_PASSWORD=TestOrganizerSecurePass123!

TEST_ADMIN_EMAIL=loadtest_admin@eventease.test
TEST_ADMIN_PASSWORD=TestAdminSecurePass123!

# Target Test Entity IDs for safe querying
TEST_SERVICE_ID=00000000-0000-0000-0000-000000000003
TEST_PACKAGE_ID=00000000-0000-0000-0000-000000000004
TEST_EVENT_ID=00000000-0000-0000-0000-000000000005
TEST_EXPO_ID=00000000-0000-0000-0000-000000000006
TEST_CONVERSATION_ID=00000000-0000-0000-0000-000000000007

# Safety Flags (Defaults to read-only/safe tests)
ALLOW_MUTATIVE_TESTS=false
ALLOW_PAYMENT_SANDBOX_TESTS=false
ALLOW_STORAGE_UPLOAD_TESTS=false
ALLOW_REALTIME_STRESS_TESTS=false

# Configurable Test Sizing
MAX_VUS_STRESS=500
SOAK_DURATION=30m
BOOKING_CONCURRENCY_VUS=50
RATE_LIMIT_BURST_VUS=50

# Webhook Verification Secret (for testing webhook endpoints)
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_test_webhook_token
